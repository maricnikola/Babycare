rule "Second Dose Euvax B and BCG After 1 Month"
when
    $e: Examination(symptoms.isEmpty() && getAgeAtExamDays() >= 29 && getAgeAtExamDays() <= 31)
then
    Vaccination vaccination1 = new Vaccination(null, VaccinationType.EUVAX_B, LocalDate.now(), 2);
    Vaccination vaccination2 = new Vaccination(null, VaccinationType.BCG, LocalDate.now(), 1);

    java.util.List<Vaccination> updated = new java.util.ArrayList<>($e.getBaby().getVaccinations());
    updated.add(vaccination1);
    updated.add(vaccination2);
//    modify($b){ setVaccinations(updated) }
    insert(vaccination1);
    insert(vaccination2);

    System.out.println("Baby " + $e.getBaby().firstName + " " + $e.getBaby().lastName + " is ready for second dose of Euvax B vaccination.");
end

rule "First Dose Pentaximm and First Dose Sinflorix After 2 Months"
when
    $b: Baby()
    $e: Examination(symptoms.isEmpty() && getAgeAtExamDays() >= 59 && getAgeAtExamDays() <= 61)
then
    Vaccination vaccination1 = new Vaccination(null, VaccinationType.PENTAXIM, LocalDate.now(), 1);
    Vaccination vaccination2 = new Vaccination(null, VaccinationType.SYNFLORIX, LocalDate.now(), 1);

    java.util.List<Vaccination> updated = new java.util.ArrayList<>($b.getVaccinations());
    updated.add(vaccination1);
    updated.add(vaccination2);
//    modify($b){ setVaccinations(updated) }
    insert(vaccination1);
    insert(vaccination2);

    System.out.println("Baby " + $b.firstName + " " + $b.lastName + " is ready for second dose of Euvax B vaccination.");
end

