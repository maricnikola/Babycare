rule "Possible Esophageal Stenosis"
when
    $e : Examination(
                  $symptoms: symptoms,
                  $b: baby
    )
     $totalWeight : Number(intValue > 15) from accumulate(
            Symptom($w : weight,
                    name == SymptomName.VOMITING_IN_STREAM ||
                    name == SymptomName.FAILURE_TO_THRIVE ||
                    name == SymptomName.PALE_SKIN||
                    name == SymptomName.COUGH)
            from $symptoms,
            sum($w)
        )
then
    Diagnosis diagnosis = new Diagnosis(null, Disease.ESOPHAGEAL_STENOSIS, LocalDate.now(), 15);
    java.util.List<Diagnosis> updated = new java.util.ArrayList<>($b.getDiagnoses());
    updated.add(diagnosis);
    modify($b){ setDiagnoses(updated) }
    insert(diagnosis);
    System.out.println("Possible Esophageal Stenosis Disease");
end

rule "Possible Penfigus Disease"
when
    $e : Examination(
                  $symptoms: symptoms,
                  $b: baby
    )
     $totalWeight : Number(intValue > 11) from accumulate(
