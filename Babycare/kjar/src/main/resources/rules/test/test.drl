rule "Possible Physiological Jaundice"
when
    $e : Examination(
                  $symptoms: symptoms,
                  $b: baby
    )

     $totalWeight : Number(intValue > 12) from accumulate(
            Symptom($w : weight,
                    name == SymptomName.MILD_FEVER||
                    name == SymptomName.YELLOW_SKIN ||
                    name == SymptomName.MODERATE_FEVER ||
                    name == SymptomName.TACHYCARDIA ||
                    name == SymptomName.FATIGUE)
            from $symptoms,
            sum($w)
        )
     exists (Diagnosis(disease == Disease.PNEUMONIA) from $b.getDiagnoses())
then
    Diagnosis diagnosis = new Diagnosis(null, Disease.PHYSIOLOGICAL_JAUNDICE, LocalDate.now(), 7);
    java.util.List<Diagnosis> updated = new java.util.ArrayList<>($b.getDiagnoses());
    updated.add(diagnosis);
    modify($b){ setDiagnoses(updated) }
    insert(diagnosis);
    System.out.println("Possible Physiological Jaundice detected");
end

rule "Possible Bronchiolitis Detection"
when
    $e : Examination(
                $symptoms : symptoms,
                $b : baby
    )
    $totalWeight : Number(intValue > 7) from accumulate(
        Symptom($w : weight,
                name == SymptomName.MILD_FEVER ||
                name == SymptomName.MODERATE_FEVER ||
                name == SymptomName.TACHYCARDIA ||
                name == SymptomName.COUGH ||
                name == SymptomName.WHEEZING ||
                name == SymptomName.CHEST_PAIN ||
                name == SymptomName.FATIGUE ||
                name == SymptomName.DYSPNEA)
        from $symptoms,
        sum($w)
    )
then
    Diagnosis diagnosis = new Diagnosis(null, Disease.BRONHIOLITIS, LocalDate.now(), 7);
    java.util.List<Diagnosis> updated = new java.util.ArrayList<>($b.getDiagnoses());
    updated.add(diagnosis);
    modify($b){ setDiagnoses(updated) }
    insert(diagnosis);
    System.out.println("Possible Bronchiolitis detected");
end

rule "Possible Pneumonia Detection"
when
    $e : Examination(
            $symptoms : symptoms,
            $b : baby
    )
    $totalWeight : Number(intValue > 12) from accumulate(
        Symptom($w : weight,
                name == SymptomName.HIGH_FEVER ||
                name == SymptomName.TACHYCARDIA ||
                name == SymptomName.COUGH ||
                name == SymptomName.CHEST_PAIN ||
                name == SymptomName.FATIGUE ||
                name == SymptomName.DYSPNEA ||
                name == SymptomName.PALE_SKIN ||
                name == SymptomName.APPETITE_LOSS ||
                name == SymptomName.VOMITING)
        from $symptoms,
        sum($w)
    )
    exists (Diagnosis(disease == Disease.BRONHIOLITIS) from $b.getDiagnoses())
then
    Diagnosis diagnosis = new Diagnosis(null, Disease.PNEUMONIA, LocalDate.now(), 7);
    java.util.List<Diagnosis> updated = new java.util.ArrayList<>($b.getDiagnoses());
    updated.add(diagnosis);
    modify($b){ setDiagnoses(updated) }
    insert(diagnosis);
    System.out.println("Possible Pneumonia detected");
end

rule "Possible Astma Detection"
when
    $e : Examination(
               $symptoms : symptoms,
               $b : baby
    )
    $totalWeight : Number(intValue > 11) from accumulate(
        Symptom($w : weight,
                name == SymptomName.COUGH ||
                name == SymptomName.DYSPNEA ||
                name == SymptomName.WHEEZING ||
                name == SymptomName.PROLONGED_EXPIRATION)
        from $symptoms,
        sum($w)
    )
    $bronhiolitisCount : Number(intValue > 3) from accumulate(
            Diagnosis(disease == Disease.BRONHIOLITIS) from $b.getDiagnoses(),
            count(1)
    )
then
    Diagnosis diagnosis = new Diagnosis(null, Disease.ASTHMA, LocalDate.now(), 7);
    java.util.List<Diagnosis> updated = new java.util.ArrayList<>($b.getDiagnoses());
    updated.add(diagnosis);
    modify($b){ setDiagnoses(updated) }
    insert(diagnosis);
    System.out.println("Possible Astma detected");
end

rule "Possible Anemia Detection"
when
     $e : Examination(
                $symptoms : symptoms,
                $b : baby
     )
    $totalWeight : Number(intValue > 15) from accumulate(
        Symptom($w : weight,
                name == SymptomName.APPETITE_LOSS ||
                name == SymptomName.FATIGUE ||
                name == SymptomName.PALE_SKIN ||
                name == SymptomName.TACHYCARDIA ||
                name == SymptomName.LOW_ERITROCYTES)
        from $symptoms,
        sum($w)
    )
then
    Diagnosis diagnosis = new Diagnosis(null, Disease.ANEMIA, LocalDate.now(), 12);
    java.util.List<Diagnosis> updated = new java.util.ArrayList<>($b.getDiagnoses());
    updated.add(diagnosis);
    modify($b){ setDiagnoses(updated) }
    insert(diagnosis);
    System.out.println("Possible Anemia detected");
end

rule "Therapy for Bronhiolitis"
when
    $d: Diagnosis(disease == Disease.BRONHIOLITIS)
then
    Treatment treatment = new Treatment(null,TreatmentType.HOSPITAL, 7, new HashSet<>());
    insert(treatment);
end

rule "Therapy for Asthma"
when
    $d: Diagnosis(disease == Disease.ASTHMA)
then
    Therapy therapy1 = new Therapy(null, "Bronhodilatator", 1, 7, Method.INHALATION);
    Therapy therapy2 = new Therapy(null, "Pulmikort", 1, 30, Method.SYRUP);
    Therapy therapy3 = new Therapy(null, "Fliksotide", 1, 30, Method.INHALATION);
    HashSet<Therapy> therapies = new HashSet<>();
    therapies.add(therapy1);
    therapies.add(therapy2);
    therapies.add(therapy3);
    Treatment treatment = new Treatment(null,TreatmentType.HOSPITAL, 7, therapies);
    insert(treatment);
end

