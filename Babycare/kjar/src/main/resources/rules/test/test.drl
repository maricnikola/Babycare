rule "Therapy for Mild Pneumonia"
when
    $d: Diagnosis(disease == Disease.PNEUMONIA)
    $e : Examination($symptoms : symptoms)
    not (Symptom(name == SymptomName.COUGH) from $symptoms)
then
    Therapy therapy1 = new Therapy(null, "Amoksicilin", 1, 3, Method.TABLET);
    Therapy therapy2 = new Therapy(null, "Paracetamol", 1, 3, Method.TABLET);
    HashSet<Therapy> therapies = new HashSet<>();
    therapies.add(therapy1);
    therapies.add(therapy2);
    Treatment treatment = new Treatment(null,TreatmentType.HOME, 7, therapies);
    insert(treatment);
end

rule "Therapy for Pneumonia with Cough"
when
    $d: Diagnosis(disease == Disease.PNEUMONIA)
    $e : Examination($symptoms : symptoms)
    exists (Symptom(name == SymptomName.COUGH) from $symptoms)
then
    Therapy therapy1 = new Therapy(null, "Oxygen", 1, 3, Method.INHALATION);
    Therapy therapy2 = new Therapy(null, "Ceftriakson", 1, 3, Method.INTRAVENOUSLY);
    HashSet<Therapy> therapies = new HashSet<>();
    therapies.add(therapy1);
    therapies.add(therapy2);
    Treatment treatment = new Treatment(null,TreatmentType.HOSPITAL, 7, therapies);
    insert(treatment);
end

